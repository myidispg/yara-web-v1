# SECURITY: Generate a strong secret key
# Run: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_KEY_50_CHARS_MIN

# SECURITY: Disable debug in production
DEBUG=0

# SECURITY: Your production domains
ALLOWED_HOSTS=yarajewels.com,api.yarajewels.com,www.yarajewels.com

# SECURITY: Your production frontend domain
CORS_ORIGINS=https://yarajewels.com,https://www.yarajewels.com

# Database credentials (use strong passwords)
DB_NAME=yara_prod_db
DB_USER=yara_prod_user
